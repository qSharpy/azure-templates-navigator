{
  "version": "0.2.0",
  "configurations": [
    {
      // F5: builds the server for this machine, copies assets, and opens
      // samples/ in an Extension Development Host.
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "build-dev",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/../../samples"]
    }
  ]
}
